# Firebase Web Client Config (copiar a .env local; NO commitear .env)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase App Check (Site Key de reCAPTCHA v3 / Enterprise obtenida en Firebase Console)
VITE_FIREBASE_RECAPTCHA_SITE_KEY=

# Solo desarrollo local (emuladores opcionales)
# VITE_USE_FIREBASE_EMULATORS=true
